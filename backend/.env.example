# Copy this file to .env and fill it in, or let ./scripts/setup-local.sh create it for you.
# .env holds secrets and is never committed.
DB_URL=jdbc:postgresql://localhost:5432/hotel_db
DB_USER=hotel_user
DB_PASSWORD=change-me
# At least 32 random characters. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
# The first administrator, created on startup if it does not exist yet (password: 8+ characters)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too
# Optional: where the website is served from (default http://localhost:5173)
# CORS_ORIGINS=http://localhost:5173

# ---- Online payments with PayHere (optional) ----
# Leave these empty and the site uses a practice card form instead. See "Online payments" in the README.
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
# A public web address PayHere can reach, ending in /api/payments/payhere/notify (for example from a tunnel such as ngrok)
# PAYHERE_NOTIFY_URL=https://your-tunnel.example/api/payments/payhere/notify
# true = PayHere's test environment (default). Use false only with a live merchant account.
# PAYHERE_SANDBOX=true
# Where guests are sent back to after paying (default http://localhost:5173)
# FRONTEND_URL=http://localhost:5173
